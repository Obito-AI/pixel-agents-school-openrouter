# Pixel Agents Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored and loaded automatically by the F5 launch config.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# OpenRouter driver for AI Champion assignment
# Copy this block to driver/.env or local .env. Never commit real keys.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL_1=qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL_2=qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL_3=openai/gpt-4o-mini
OPENROUTER_MODEL_4=qwen/qwen-2.5-7b-instruct
PIXEL_AGENT_MAX_ITERATIONS=3
